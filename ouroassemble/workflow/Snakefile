]
if config["merge"]["enabled"]:
    FINAL += ["final/merged_assembly.fa", "final/merged_assembly.tsv"]
if config["junction"]["igv_reports"]:
    FINAL += expand("05_validation/{asm}/igv_report.html", asm=ASSEMBLERS)


# `rule all` (the default target) is defined in ../Snakefile, the main Snakefile,
